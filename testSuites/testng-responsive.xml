<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Responsive/Viewport Test Suite
  Verifies pages render correctly at different screen sizes (desktop, tablet, mobile).

  Usage:
    mvn test -Denv=prod -Dbrowser=chrome \
      -Dsurefire.suiteXmlFiles=testSuites/testng-responsive.xml
-->
<suite name="MYBharat Responsive Tests" parallel="false" verbose="1">
    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>
    <test name="Responsive Layout Tests" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.responsive.ResponsiveTest"/>
        </classes>
    </test>
</suite>
