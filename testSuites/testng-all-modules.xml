<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="MYBharat All Modules" parallel="tests" thread-count="2" verbose="1"
       group-by-instances="true" preserve-order="true">

    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>

    <!-- ================================================================== -->
    <!-- POSITIVE FLOW TESTS                                                 -->
    <!-- ================================================================== -->

    <test name="Youth Flow" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
            <class name="com.mybharat.tests.youth.LogoutTest"/>
            <class name="com.mybharat.tests.youth.LoginTest"/>
            <class name="com.mybharat.tests.youth.YouthProfileTest"/>
            <class name="com.mybharat.tests.youth.RegistrationCertificateVerificationTest"/>
            <class name="com.mybharat.tests.youth.BasicInfoTest"/>
            <class name="com.mybharat.tests.youth.QuizAttemptTest"/>
            <class name="com.mybharat.tests.youth.QuizCertificateVerificationTest"/>
            <class name="com.mybharat.tests.blog.BlogTest"/>
            <class name="com.mybharat.tests.negative.BlogNegativeTest"/>
        </classes>
    </test>

    <test name="Youth Club Flow" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.org.RegisterMembersForYouthClubTest"/>
            <class name="com.mybharat.tests.org.CreateYouthClubTest"/>
        </classes>
    </test>

    <!-- ================================================================== -->
    <!-- NEGATIVE TEST CASES                                                 -->
    <!-- ================================================================== -->

    <test name="Registration Negative Tests" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.negative.RegistrationNegativeTest"/>
        </classes>
    </test>

    <test name="Login Negative Tests" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.negative.LoginNegativeTest"/>
        </classes>
    </test>

    <!-- Blog Negative Tests run in the Youth Flow test block since they need auth -->

    <!-- ================================================================== -->
    <!-- RESPONSIVE / VIEWPORT TESTS                                         -->
    <!-- ================================================================== -->

    <test name="Responsive Layout Tests" preserve-order="true">
        <classes>
            <class name="com.mybharat.tests.responsive.ResponsiveTest"/>
        </classes>
    </test>

</suite>
