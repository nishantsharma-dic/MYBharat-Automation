<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ============================================================
  Registration → Logout → Login Suite
  ============================================================
  Purpose: Runs the basic auth flow — register a new user, logout,
           then login again using OTP.
  
  Flow:
    Step 1: Registration — Register new Indian youth, save email to Excel
    Step 2: Logout — Log out the newly registered user
    Step 3: Login — Re-login using email from Excel (OTP via Maildrop API)
  
  Prerequisites:
    - Maildrop API must be accessible (for OTP in registration and login)
    - resources/ folder must be writable (Excel persistence)
  
  Run with:
    mvn test -Denv=beta -Dbrowser=chrome -Dsurefire.suiteXmlFiles=testSuites/testng-registration-logout-login.xml
    mvn test -Denv=prod -Dbrowser=chrome -Dsurefire.suiteXmlFiles=testSuites/testng-registration-logout-login.xml
  
  Team: QA Team | Developer: Nishant Sharma
  ============================================================
-->
<suite name="Registration Logout Login Suite" parallel="false" verbose="1">

    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>

    <!-- Step 1: Registration → Submit popup → Save email to Excel -->
    <test name="Youth Registration">
        <classes>
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
        </classes>
    </test>

    <!-- Step 2: Logout after registration -->
    <test name="Logout After Registration">
        <classes>
            <class name="com.mybharat.tests.youth.LogoutTest"/>
        </classes>
    </test>

    <!-- Step 3: Login with email from Excel (OTP via Maildrop API) -->
    <test name="Youth Login">
        <classes>
            <class name="com.mybharat.tests.youth.LoginTest"/>
        </classes>
    </test>

</suite>
