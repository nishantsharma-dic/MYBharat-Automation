<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║        QUIZ REWARD REFERENCE_ID VERIFICATION SUITE                   ║
  ╠══════════════════════════════════════════════════════════════════════╣
  ║                                                                     ║
  ║  Purpose: Verify that the frontend fix for null quiz_id in          ║
  ║           vms_user_reward_history is working correctly.              ║
  ║                                                                     ║
  ║  Bug: Reference_ID (quiz_id) was going NULL in the                  ║
  ║       vms_user_reward_history table after quiz submission.           ║
  ║                                                                     ║
  ║  Fix: Frontend now validates quiz_id is present before              ║
  ║       calling the reward API.                                       ║
  ║                                                                     ║
  ║  Flow:                                                              ║
  ║    1. Register a new user (fresh email via Maildrop API)            ║
  ║    2. Navigate to Quiz section and complete a quiz                  ║
  ║    3. Query vms_user_reward_history via Redash API                  ║
  ║    4. Assert Reference_ID is NOT null for the quiz reward entry     ║
  ║                                                                     ║
  ║  Run (beta):                                                        ║
  ║    mvn test -Denv=beta -Dbrowser=chrome                             ║
  ║      -Dsurefire.suiteXmlFiles=testSuites/testng-quiz-reward-verification.xml ║
  ║      -DredashBaseUrl=https://dash-beta.mybharats.in                 ║
  ║      -DredashRewardQueryId=XX                                       ║
  ║      -DredashApiKey=YOUR_API_KEY                                    ║
  ║      -DcloseBrowser=false                                           ║
  ║                                                                     ║
  ║  Required Redash Query:                                             ║
  ║    SELECT u.email, r.reference_id, r.reward_type, r.created_at      ║
  ║    FROM vms_user_reward_history r                                    ║
  ║    JOIN users u ON u.id = r.user_id                                 ║
  ║    WHERE r.created_at >= NOW() - INTERVAL '1 hour'                  ║
  ║    ORDER BY r.created_at DESC;                                      ║
  ║                                                                     ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->
<suite name="Quiz Reward Reference_ID Verification" parallel="none" verbose="1" preserve-order="true">

    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>

    <test name="Register → Quiz → Verify Reward Reference_ID" preserve-order="true">
        <classes>
            <!-- Step 1: Register new youth user (email + OTP from Maildrop API) -->
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
            <!-- Step 2: Complete quiz + Step 3: Verify Reference_ID in DB -->
            <class name="com.mybharat.tests.youth.QuizRewardReferenceIdTest"/>
        </classes>
    </test>

</suite>
