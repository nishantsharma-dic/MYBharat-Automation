<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Cross-Browser Test Suite
  Runs the core youth registration + login flow on multiple browser configurations.

  Usage:
    mvn test -Denv=prod -Dsurefire.suiteXmlFiles=testSuites/testng-cross-browser.xml

  Browsers tested:
    - Chrome (headed)
    - Chrome Headless
    - Firefox

  Note: Each <test> block uses a separate parameter to override the browser setting.
        The BaseTest.createDriver() reads System.getProperty("browser") which is set
        per <test> via the <parameter> tag.
-->
<suite name="MYBharat Cross-Browser Suite" parallel="tests" thread-count="1" verbose="1">
    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>

    <!-- Chrome Headed -->
    <test name="Chrome - Registration + Login">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
            <class name="com.mybharat.tests.youth.LogoutTest"/>
            <class name="com.mybharat.tests.youth.LoginTest"/>
        </classes>
    </test>

    <!-- Chrome Headless -->
    <test name="Chrome Headless - Registration + Login">
        <parameter name="browser" value="headless"/>
        <classes>
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
            <class name="com.mybharat.tests.youth.LogoutTest"/>
            <class name="com.mybharat.tests.youth.LoginTest"/>
        </classes>
    </test>

    <!-- Firefox -->
    <test name="Firefox - Registration + Login">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.mybharat.tests.youth.RegistrationTest"/>
            <class name="com.mybharat.tests.youth.LogoutTest"/>
            <class name="com.mybharat.tests.youth.LoginTest"/>
        </classes>
    </test>
</suite>
