<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ============================================================
  Spam Email Restriction Test Suite
  ============================================================
  Purpose: Verifies that spam/dummy domain emails are blocked from
           registration on the main registration page.
  
  Run:
    mvn test -Denv=beta -Dbrowser=chrome -Dsurefire.suiteXmlFiles=testSuites/testng-spam-email-restriction.xml
  
  Team: QA Team
  ============================================================
-->
<suite name="Spam Email Restriction Suite" parallel="false" verbose="1">

    <listeners>
        <listener class-name="com.mybharat.listeners.TestListeners"/>
    </listeners>

    <test name="Spam Email Restriction - Main Registration Page">
        <classes>
            <class name="com.mybharat.tests.youth.SpamEmailRestrictionTest"/>
        </classes>
    </test>

</suite>
